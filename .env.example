# Local-only HTTP server. Keep HOST loopback while authentication is disabled.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/shopee-tracker.db

# Price-tracker application authentication, separate from Shopee sign-in.
AUTH_ENABLED=false
AUTH_ALLOW_REGISTRATION=false
AUTH_SESSION_TTL_HOURS=720

# Persistent extension collection jobs.
COLLECTION_JOB_LEASE_MS=300000
COLLECTION_MAX_ATTEMPTS=4
COLLECTION_RETRY_BASE_DELAY_MS=5000
COLLECTION_RETRY_MAX_DELAY_MS=300000
COLLECTION_DISPATCH_DELAY_MIN_MS=5000
COLLECTION_DISPATCH_DELAY_MAX_MS=10000

# Scheduler dispatches jobs; the signed-in Chrome extension performs collection.
CRON_ENABLED=true
CRON_SCHEDULE=0 */12 * * *

# Retained anonymous Playwright discovery and integration settings.
SHOPEE_HEADLESS=true
SHOPEE_PRICE_SCALE=100000

SCRAPE_TIMEOUT_MS=45000
SCRAPE_DELAY_MIN_MS=5000
SCRAPE_DELAY_MAX_MS=10000
SCRAPE_MAX_RETRIES=2

PRICE_DROP_THRESHOLD_PERCENT=1
VARIANT_MISSING_THRESHOLD=3
MAX_VARIANT_MISSING_RATIO=0.5
VARIANT_MASS_MISSING_CONFIRMATIONS=2

# Optional Telegram delivery. Both credential values are required to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REQUEST_TIMEOUT_MS=3000
TELEGRAM_MAX_ATTEMPTS=2
TELEGRAM_RETRY_BASE_DELAY_MS=500
TELEGRAM_RETRY_MAX_DELAY_MS=2000

# Set this to chrome-extension://<extension-id> after loading dist/extension.
EXTENSION_ALLOWED_ORIGIN=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
LOG_LEVEL=info
