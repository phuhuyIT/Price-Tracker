NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/shopee-tracker.db

AUTH_ENABLED=false
AUTH_ALLOW_REGISTRATION=false
AUTH_SESSION_TTL_HOURS=720

COLLECTION_JOB_LEASE_MS=120000

CRON_ENABLED=true
CRON_SCHEDULE=0 */12 * * *

SHOPEE_HEADLESS=true
SHOPEE_PRICE_SCALE=100000

SCRAPE_TIMEOUT_MS=45000
SCRAPE_DELAY_MIN_MS=5000
SCRAPE_DELAY_MAX_MS=10000
SCRAPE_MAX_RETRIES=2

PRICE_DROP_THRESHOLD_PERCENT=1
VARIANT_MISSING_THRESHOLD=3
MAX_VARIANT_MISSING_RATIO=0.5
VARIANT_MASS_MISSING_CONFIRMATIONS=2

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

EXTENSION_ALLOWED_ORIGIN=
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
LOG_LEVEL=info
