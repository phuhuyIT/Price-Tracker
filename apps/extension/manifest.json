{
  "manifest_version": 3,
  "name": "Shopee Price Tracker",
  "version": "0.8.8",
  "description": "Capture displayed Shopee prices and submit them to the local price tracker.",
  "minimum_chrome_version": "116",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Shopee Price Tracker",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://shopee.vn/*", "https://*.shopee.vn/*"],
      "js": ["content/content-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://shopee.vn/*", "https://*.shopee.vn/*"],
      "js": ["content/page-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:* http://localhost:* https:"
  },
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.shopee.vn/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "optional_host_permissions": ["https://*/*"],
  "permissions": ["activeTab", "alarms", "notifications", "storage"]
}
